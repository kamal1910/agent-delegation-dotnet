<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- RQ4 case study: the refund flow as a Dapr workflow. One executable, three roles (payments API, workflow
       worker, driver); the driver starts the other two as child processes. See README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapr.Workflow" Version="1.18.10" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.29" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentDelegation\AgentDelegation.csproj" />
    <ProjectReference Include="..\..\src\AgentDelegation.AspNetCore\AgentDelegation.AspNetCore.csproj" />
  </ItemGroup>

</Project>
